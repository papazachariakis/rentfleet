{
  "name": "rentfleet",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @rentfleet/api prisma generate",
    "db:migrate": "pnpm --filter @rentfleet/api prisma migrate dev",
    "db:push": "pnpm --filter @rentfleet/api prisma db push",
    "db:studio": "pnpm --filter @rentfleet/api prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.0.14",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@9.10.0"
}
